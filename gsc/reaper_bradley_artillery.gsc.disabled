isBradleySupportedMap( mapName )
{
    if ( !isdefined( mapName ) )
        return 0;

    switch ( mapName )
    {
        case "mp_alpha":
        case "mp_bootleg":
        case "mp_bravo":
        case "mp_carbon":
        case "mp_dome":
        case "mp_hardhat":
        case "mp_interchange":
        case "mp_lambeth":
        case "mp_meteora":
        case "mp_paris":
        case "mp_plaza2":
        case "mp_radar":
        case "mp_seatown":
            return 1;
    }

    return 0;
}

hideDestructiblePartWithBradleyGuard( partName )
{
    // Carbon contains a multipart destructible state whose requested part is
    // absent from the active model. Bradley salvos reach that otherwise-rare
    // state repeatedly, and stock hideapart() forwards it to hidepart()
    // without validation. IW5 exposes no model-part predicate, so suppress
    // only those transitions while this streak is active on Carbon.
    if (
        isdefined( level.script ) &&
        level.script == "mp_carbon" &&
        isdefined( level.mobilemortar )
    )
    {
        return;
    }

    self hidepart( partName );
}

installBradleyCallback()
{
    level endon( "game_ended" );

    while (
        !isdefined( level.killstreakfuncs ) ||
        !isdefined( level.killstreakfuncs["remote_mortar"] )
    )
    {
        wait 0.05;
    }

    // Retain the callback installed by _remotemortar::init so unsupported
    // maps can still use the player-controlled Reaper instead of holding an
    // unusable nine-kill reward.
    level.funModeStockReaperCallback = level.killstreakfuncs["remote_mortar"];
    level.killstreakfuncs["remote_mortar"] = ::tryUseBradleyArtillery;
}

tryUseBradleyArtillery( lifeId )
{
    if ( !isdefined( level.ground_support_locs[level.script] ) )
    {
        if ( isdefined( level.funModeStockReaperCallback ) )
            return self [[ level.funModeStockReaperCallback ]]( lifeId );

        return 0;
    }

    if (
        isdefined( self.laststand ) &&
        !self maps\mp\_utility::_hasperk( "specialty_finalstand" )
    )
    {
        self iprintlnbold( &"MP_UNAVILABLE_IN_LASTSTAND" );
        return 0;
    }

    if ( isdefined( level.mobilemortar ) )
    {
        self iprintlnbold( &"MP_GROUND_APPROACHES_TOO_CROWDED" );
        return 0;
    }

    if ( self maps\mp\_utility::isusingremote() )
        return 0;

    // Each supported map has exactly three shipped ground-support entrances.
    // Random selection removes the slow laptop UI without inventing unsafe
    // world coordinates or changing the vehicle's authored approach paths.
    entranceIndex = randomint( 3 );

    bradley = createBradleyVehicle( self, entranceIndex );

    if ( !isdefined( bradley ) )
        return 0;

    // vehicle_bradley is referenced by the dormant script but absent from the
    // shipped MP zone. Its missing-model proxy is the damaging red FX object
    // seen in-world. Assemble the real UGV chassis and turret models while
    // preserving the Bradley entity's movement, health, and targeting logic.
    bradley.presentationTurret = spawn( "script_model", bradley.origin );

    if ( isdefined( bradley.presentationTurret ) )
    {
        bradley.presentationTurret setmodel( "vehicle_ugv_talon_gun_mp" );
        bradley.presentationTurret linkto(
            bradley,
            "tag_turret_attach",
            ( 0, 0, 0 ),
            ( 0, 0, 0 )
        );
    }

    bradley thread moveBradleyToPosition( "entrance" );
    self thread restoreWeaponAfterBradleyActivation();
    return 1;
}

createBradleyVehicle( owner, entranceIndex )
{
    entrance = level.ground_support_locs[level.script][entranceIndex];
    heightOffset = maps\mp\killstreaks\_airdrop::getflyheightoffset(
        entrance["origin"]
    );
    groundTrace = bullettrace(
        entrance["origin"] + ( 0, 0, heightOffset ),
        entrance["origin"] - ( 0, 0, heightOffset ),
        0
    );
    spawnOrigin = groundTrace["position"] +
        anglestoforward( entrance["angles"] ) * -1000;
    bradley = spawn( "script_model", spawnOrigin );

    if ( !isdefined( bradley ) )
        return undefined;

    bradley.angles = entrance["angles"];
    bradley setmodel( "vehicle_ugv_talon_mp" );
    bradley setcandamage( 1 );
    bradley.maxhealth = level.heli_maxhealth * 2;
    bradley.health = bradley.maxhealth;
    bradley.owner = owner;
    bradley.playersattacked = [];
    bradley.lasttarget = bradley.origin;
    bradley.helitype = "helicopter";
    bradley.heli_type = "helicopter";

    if ( level.teambased )
        bradley.team = owner.team;

    bradley.lowx = level.spawnpoints[0].origin[0];
    bradley.highx = level.spawnpoints[0].origin[0];
    bradley.lowy = level.spawnpoints[0].origin[1];
    bradley.highy = level.spawnpoints[0].origin[1];
    boundsInset = 200;

    if ( level.spawnpoints.size > 1 )
    {
        for ( index = 1; index < level.spawnpoints.size; index++ )
        {
            spawnpoint = level.spawnpoints[index].origin;

            if ( spawnpoint[0] < bradley.lowx )
                bradley.lowx = spawnpoint[0];
            else if ( spawnpoint[0] > bradley.highx )
                bradley.highx = spawnpoint[0];

            if ( spawnpoint[1] < bradley.lowy )
                bradley.lowy = spawnpoint[1];
            else if ( spawnpoint[1] > bradley.highy )
                bradley.highy = spawnpoint[1];
        }
    }
    else
        boundsInset = -2000;

    bradley.lowx += boundsInset;
    bradley.highx -= boundsInset;
    bradley.lowy += boundsInset;
    bradley.highy -= boundsInset;

    if ( level.teambased )
    {
        friendlyObjective = maps\mp\gametypes\_gameobjects::getnextobjid();
        objective_add( friendlyObjective, "invisible", ( 0, 0, 0 ) );
        objective_position( friendlyObjective, groundTrace["position"] );
        objective_state( friendlyObjective, "active" );
        objective_team( friendlyObjective, bradley.team );
        objective_icon( friendlyObjective, "compass_objpoint_airstrike_friendly" );
        bradley.objidfriendly = friendlyObjective;

        enemyObjective = maps\mp\gametypes\_gameobjects::getnextobjid();
        objective_add( enemyObjective, "invisible", ( 0, 0, 0 ) );
        objective_position( enemyObjective, groundTrace["position"] );
        objective_state( enemyObjective, "active" );
        objective_team( enemyObjective, level.otherteam[bradley.team] );
        objective_icon( enemyObjective, "compass_objpoint_airstrike_busy" );
        bradley.objidenemy = enemyObjective;
    }

    bradley thread watchBradleyTimeout();
    bradley thread maps\mp\killstreaks\_helicopter::heli_damage_monitor();
    bradley thread watchBradleyDeath();
    bradley thread maps\mp\killstreaks\_mobilemortar::watchproximity();
    level.mobilemortar = bradley;
    return bradley;
}

restoreWeaponAfterBradleyActivation()
{
    self endon( "disconnect" );
    self endon( "death" );
    level endon( "game_ended" );

    waittillframeend;
    returnWeapon = common_scripts\utility::getlastweapon();

    if (
        !isdefined( returnWeapon ) ||
        returnWeapon == "none" ||
        !self hasweapon( returnWeapon )
    )
    {
        primaryWeapons = self getweaponslistprimaries();

        if ( !primaryWeapons.size )
            return;

        returnWeapon = primaryWeapons[0];
    }

    self switchtoweapon( returnWeapon );
}

moveBradleyToPosition( direction )
{
    level endon( "game_ended" );
    self endon( "death" );

    if ( direction == "entrance" )
        destination = self.origin + anglestoforward( self.angles ) * 1000;
    else
    {
        self notify( "leaving" );
        destination = self.origin + anglestoforward( self.angles ) * -1000;
    }

    travelTime = 3.0;
    self moveto( destination, travelTime, travelTime * 0.6, travelTime * 0.4 );
    wait( travelTime );

    if ( direction == "entrance" )
    {
        self thread runBradleyArtillery();
        return;
    }

    cleanupBradleyObjectives();

    if ( isdefined( self.presentationTurret ) )
        self.presentationTurret delete();

    level.mobilemortar = undefined;
    self delete();
}

runBradleyArtillery()
{
    level endon( "game_ended" );
    self endon( "death" );
    self endon( "leaving" );

    for (;;)
    {
        salvoStartTime = gettime();
        target = self maps\mp\killstreaks\_mobilemortar::findtarget();

        if ( !isdefined( target ) )
            target = self maps\mp\killstreaks\_mobilemortar::findrandomtarget();

        salvoSize = getdvarint( "fun_mode_bradley_salvo_size" );
        spacing = getdvarfloat( "fun_mode_bradley_salvo_spacing_seconds" );
        spread = getdvarfloat( "fun_mode_bradley_salvo_spread" );

        if ( salvoSize < 1 )
            salvoSize = 1;
        else if ( salvoSize > 6 )
            salvoSize = 6;

        if ( spacing < 0.05 )
            spacing = 0.05;

        if ( spread < 0 )
            spread = 0;

        for ( shot = 0; shot < salvoSize; shot++ )
        {
            strikeTarget = target;

            if ( shot > 0 && spread > 0 )
            {
                strikeTarget += (
                    randomfloatrange( spread * -1, spread ),
                    randomfloatrange( spread * -1, spread ),
                    0
                );
            }

            height = self.origin[2] + 3500;
            groundTrace = bullettrace(
                strikeTarget + ( 0, 0, height ),
                strikeTarget - ( 0, 0, height ),
                0
            );
            apex = strikeTarget + ( 0, 0, height );
            impact = strikeTarget + ( 0, 0, groundTrace["position"][2] );

            self playsound( "bmp_fire" );
            self thread maps\mp\killstreaks\_mobilemortar::mortarrecoil();
            level thread fireBradleyMissile( self, apex, impact );

            if ( shot < salvoSize - 1 )
                wait spacing;
        }

        salvoInterval = getdvarfloat( "fun_mode_bradley_salvo_interval_seconds" );

        if ( salvoInterval < 1 )
            salvoInterval = 1;

        elapsedSeconds = ( gettime() - salvoStartTime ) / 1000.0;
        remainingDelay = salvoInterval - elapsedSeconds;

        if ( remainingDelay < 0.05 )
            remainingDelay = 0.05;

        wait remainingDelay;
    }
}

fireBradleyMissile( bradley, apex, impact )
{
    level endon( "game_ended" );

    if ( !isdefined( bradley ) || !isdefined( bradley.owner ) )
        return;

    owner = bradley.owner;
    ascent = magicbullet(
        "javelin_mp",
        bradley.origin + ( 0, 0, 150 ),
        apex,
        owner
    );

    elapsed = 0;

    while (
        isdefined( ascent ) &&
        elapsed <= 115 &&
        distancesquared( ascent.origin, apex ) >= 500
    )
    {
        wait 0.05;
        elapsed++;
    }

    if ( isdefined( ascent ) )
        ascent delete();

    if ( !isdefined( bradley ) || !isdefined( owner ) )
        return;

    missile = magicbullet(
        "remote_mortar_missile_mp",
        apex + ( 0, 0, 200 ),
        impact,
        owner
    );
}

watchBradleyTimeout()
{
    level endon( "game_ended" );
    self endon( "death" );

    duration = getdvarfloat( "fun_mode_bradley_duration_seconds" );

    if ( duration < 5 )
        duration = 5;

    maps\mp\gametypes\_hostmigration::waitlongdurationwithhostmigrationpause(
        duration
    );
    self setcandamage( 0 );
    self thread moveBradleyToPosition( "exit" );
}

watchBradleyDeath()
{
    level endon( "game_ended" );
    self endon( "leaving" );
    self waittill( "death" );

    destroyedBradley = spawn( "script_model", self.origin );

    if ( isdefined( destroyedBradley ) )
    {
        destroyedBradley setmodel( "vehicle_ugv_talon_mp" );
        destroyedBradley.angles = self.angles;
    }

    cleanupBradleyObjectives();

    if ( isdefined( self.presentationTurret ) )
        self.presentationTurret delete();

    self delete();
    wait 3.5;

    if ( isdefined( destroyedBradley ) )
        destroyedBradley delete();

    level.mobilemortar = undefined;
}

cleanupBradleyObjectives()
{
    if ( isdefined( self.objidfriendly ) )
        maps\mp\_utility::_objective_delete( self.objidfriendly );

    if ( isdefined( self.objidenemy ) )
        maps\mp\_utility::_objective_delete( self.objidenemy );
}
